{
  "name": "failure-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "server": "node --import tsx server/index.ts",
    "format": "prettier --write src server tests/*.ts *.json *.ts *.yml .github/workflows/*.yml"
  },
  "dependencies": {
    "amqplib": "0.10.5",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "prettier": "3.9.9"
  }
}
